<Window x:Class="OsnovnaSredstva.Views.OsMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FIN Osnovna sredstva"
        Width="480" Height="660"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Glavni meni dugmad -->
        <Style x:Key="MenuDugme" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Margin" Value="5,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,2"
                                           Visibility="{Binding Tag, RelativeSource={RelativeSource TemplatedParent},
                                                        Converter={StaticResource StringToVisibilityConverter}}"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Padding="6,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Footer utility dugmad -->
        <Style x:Key="UtilDugme" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Background="#EEF2F8">

        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#1565C0" Padding="16,10">
            <StackPanel>
                <TextBlock Text="OSNOVNA SREDSTVA"
                           FontSize="16" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding NaslovHeader}"
                           FontSize="11" Foreground="#BBDEFB" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="#D8E4F0"
                BorderBrush="#B8CCE4" BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <Button Content="Izlaz"
                        DockPanel.Dock="Right"
                        Style="{StaticResource UtilDugme}"
                        Background="#C62828" Width="88"
                        Command="{Binding OdjavaCommand}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Promena firme"
                            Style="{StaticResource UtilDugme}"
                            Background="#455A64"
                            Command="{Binding PromenaFirmeCommand}"/>
                    <Button Content="Promena godine"
                            Style="{StaticResource UtilDugme}"
                            Background="#455A64"
                            Command="{Binding PromenaGodineCommand}"/>
                    <Button Content="Korisnici"
                            Style="{StaticResource UtilDugme}"
                            Background="#455A64"
                            Command="{Binding OtvoriLozinkeCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Meni dugmad — 2 kolone, 5 redova -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,4">
            <UniformGrid Columns="2">

                <!-- Red 1: Kartice OS | Evidencija -->
                <Button Content="Kartice OS"
                        Style="{StaticResource MenuDugme}"
                        Background="#0277BD"
                        Command="{Binding OtvoriKarticeCommand}"/>

                <Button Content="Evidencija"
                        Style="{StaticResource MenuDugme}"
                        Background="#1565C0"
                        Command="{Binding OtvoriEvidencijuCommand}"/>

                <!-- Red 2: Amortizacija OA | Šifarnici OS -->
                <Button Content="Amortizacija OA"
                        Style="{StaticResource MenuDugme}"
                        Background="#00838F"
                        Command="{Binding OtvoriStampaCommand}"/>

                <Button Content="Šifarnici OS"
                        Style="{StaticResource MenuDugme}"
                        Background="#00695C"
                        Command="{Binding OtvoriSifarNiciCommand}"/>

                <!-- Red 3: Arhiva | Prenos u novu godinu -->
                <Button Content="Arhiva"
                        Style="{StaticResource MenuDugme}"
                        Background="#546E7A"
                        Command="{Binding OtvoriArhivuCommand}"/>

                <Button Content="Prenos u novu godinu"
                        Style="{StaticResource MenuDugme}"
                        Background="#E65100"
                        Command="{Binding OtvoriPrenosuCommand}"/>

                <!-- Red 4: Partneri | Mesta -->
                <Button Content="Partneri"
                        Style="{StaticResource MenuDugme}"
                        Background="#2E7D32"
                        Command="{Binding OtvoriPartnereCommand}"/>

                <Button Content="Mesta"
                        Style="{StaticResource MenuDugme}"
                        Background="#388E3C"
                        Command="{Binding OtvoriMestaCommand}"/>

                <!-- Red 5: Izvoz tabele | Podaci o firmi -->
                <Button Content="Izvoz tabele"
                        Style="{StaticResource MenuDugme}"
                        Background="#4527A0"
                        Command="{Binding OtvoriIzvozCommand}"/>

                <Button Content="Podaci o firmi"
                        Style="{StaticResource MenuDugme}"
                        Background="#6A1B9A"
                        Command="{Binding OtvoriPodatkeOFirmiCommand}"/>

            </UniformGrid>
        </ScrollViewer>

    </DockPanel>
</Window>
