<Window x:Class="OsnovnaSredstva.Views.OsMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FIN OSNOVNA SREDSTVA — Glavni meni"
        Width="900" Height="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="780" MinHeight="540"
        Background="#F3F6FB">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>     <!-- Header -->
            <RowDefinition Height="32"/>     <!-- Info bar -->
            <RowDefinition Height="*"/>      <!-- Sadrzaj -->
            <RowDefinition Height="32"/>     <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="#1565C0">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="19"
                            Background="#0D47A1" Margin="0,0,12,0">
                        <TextBlock Text="OS" FontFamily="Tahoma" FontSize="14"
                                   FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="FIN OSNOVNA SREDSTVA"
                                   FontFamily="Tahoma" FontSize="18" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Upravljanje i amortizacija osnovnih sredstava"
                                   FontFamily="Tahoma" FontSize="10"
                                   Foreground="#BBDEFB"/>
                    </StackPanel>
                </StackPanel>

                <!-- Desna strana headera -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="Podaci o firmi"
                            FontFamily="Tahoma" FontSize="10"
                            Foreground="White" Background="#0D47A1"
                            BorderBrush="#42A5F5" BorderThickness="1"
                            Padding="8,4" Cursor="Hand" Margin="0,0,8,0"
                            Command="{Binding OtvoriPodatkeOFirmiCommand}"/>
                    <Button Content="Promena firme"
                            FontFamily="Tahoma" FontSize="10"
                            Foreground="#BBDEFB" Background="Transparent"
                            BorderBrush="#64B5F6" BorderThickness="1"
                            Padding="8,4" Cursor="Hand" Margin="0,0,8,0"
                            Command="{Binding PromenaFirmeCommand}"/>
                    <Button Content="Odjava"
                            FontFamily="Tahoma" FontSize="10"
                            Foreground="White" Background="#D32F2F"
                            BorderBrush="#B71C1C" BorderThickness="1"
                            Padding="8,4" Cursor="Hand"
                            Command="{Binding OdjavaCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ INFO BAR ═══ -->
        <Border Grid.Row="1" Background="#0D47A1">
            <TextBlock Text="{Binding NaslovHeader}"
                       FontFamily="Tahoma" FontSize="11"
                       Foreground="#90CAF9"
                       VerticalAlignment="Center"
                       Margin="16,0"/>
        </Border>

        <!-- ═══ GLAVNI SADRZAJ ═══ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,20,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ─── Kolona 1: Evidencija ─── -->
                <Border Grid.Column="0" Grid.Row="0" Background="White"
                        CornerRadius="6" Padding="0,0,0,4"
                        BorderBrush="#90CAF9" BorderThickness="1">
                    <StackPanel>
                        <Border Background="#1565C0" CornerRadius="6,6,0,0" Padding="12,8">
                            <TextBlock Text="EVIDENCIJA"
                                       FontFamily="Tahoma" FontSize="12" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                        <Button Content="Kartice OS"
                                Style="{StaticResource OsMeniDugme}"
                                Margin="8,8,8,0"
                                Command="{Binding OtvoriKarticeCommand}"/>
                        <Button Content="Inventar"
                                Style="{StaticResource OsMeniDugme}"
                                Margin="8,0,8,0"
                                Command="{Binding OtvoriInventarCommand}"/>
                        <Button Content="Grupe OS"
                                Style="{StaticResource OsMeniDugme}"
                                Margin="8,0,8,4"
                                Command="{Binding OtvoriGrupeCommand}"/>
                    </StackPanel>
                </Border>

                <!-- ─── Kolona 2: Amortizacija ─── -->
                <Border Grid.Column="2" Grid.Row="0" Background="White"
                        CornerRadius="6" Padding="0,0,0,4"
                        BorderBrush="#90CAF9" BorderThickness="1">
                    <StackPanel>
                        <Border Background="#1565C0" CornerRadius="6,6,0,0" Padding="12,8">
                            <TextBlock Text="AMORTIZACIJA"
                                       FontFamily="Tahoma" FontSize="12" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                        <Button Content="Obračun amortizacije"
                                Style="{StaticResource OsMeniDugme}"
                                Margin="8,8,8,0"
                                Command="{Binding OtvoriAmortizacijaCommand}"/>
                        <Button Content="Rashodovanje / Otuđenje"
                                Style="{StaticResource OsMeniDugme}"
                                Margin="8,0,8,0"
                                Command="{Binding OtvoriRashodovanjeCommand}"/>
                        <Button Content="Knjiženje u GK"
                                Style="{StaticResource OsMeniDugme}"
                                Margin="8,0,8,4"
                                Command="{Binding OtvoriKnjizenjeCommand}"/>
                    </StackPanel>
                </Border>

                <!-- ─── Kolona 3: Stampa ─── -->
                <Border Grid.Column="4" Grid.Row="0" Background="White"
                        CornerRadius="6" Padding="0,0,0,4"
                        BorderBrush="#90CAF9" BorderThickness="1">
                    <StackPanel>
                        <Border Background="#1565C0" CornerRadius="6,6,0,0" Padding="12,8">
                            <TextBlock Text="ŠTAMPA"
                                       FontFamily="Tahoma" FontSize="12" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                        <Button Content="Štampa kartica"
                                Style="{StaticResource OsMeniDugme}"
                                Margin="8,8,8,0"
                                Command="{Binding OtvoriStampaCommand}"/>
                        <Button Content="Izveštaji"
                                Style="{StaticResource OsMeniDugme}"
                                Margin="8,0,8,4"
                                Command="{Binding OtvoriStampaCommand}"/>
                    </StackPanel>
                </Border>

                <!-- ─── Kolona 1, red 2: Prenos ─── -->
                <Border Grid.Column="0" Grid.Row="2" Background="White"
                        CornerRadius="6" Padding="0,0,0,4"
                        BorderBrush="#90CAF9" BorderThickness="1">
                    <StackPanel>
                        <Border Background="#1565C0" CornerRadius="6,6,0,0" Padding="12,8">
                            <TextBlock Text="PRENOS PODATAKA"
                                       FontFamily="Tahoma" FontSize="12" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                        <Button Content="Prenos u novu godinu"
                                Style="{StaticResource OsMeniDugme}"
                                Margin="8,8,8,4"
                                Command="{Binding OtvoriPrenosCommand}"/>
                    </StackPanel>
                </Border>

                <!-- ─── Kolona 2, red 2: Sifarnici ─── -->
                <Border Grid.Column="2" Grid.Row="2" Background="White"
                        CornerRadius="6" Padding="0,0,0,4"
                        BorderBrush="#90CAF9" BorderThickness="1">
                    <StackPanel>
                        <Border Background="#1565C0" CornerRadius="6,6,0,0" Padding="12,8">
                            <TextBlock Text="ŠIFARNICI"
                                       FontFamily="Tahoma" FontSize="12" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                        <Button Content="Šifarnici"
                                Style="{StaticResource OsMeniDugme}"
                                Margin="8,8,8,0"
                                Command="{Binding OtvoriSifarNiciCommand}"/>
                        <Button Content="Parametri sistema"
                                Style="{StaticResource OsMeniDugme}"
                                Margin="8,0,8,4"
                                Command="{Binding OtvoriParametriCommand}"/>
                    </StackPanel>
                </Border>

                <!-- ─── Kolona 3, red 2: Korisnik info ─── -->
                <Border Grid.Column="4" Grid.Row="2" Background="White"
                        CornerRadius="6" Padding="12,12"
                        BorderBrush="#90CAF9" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Prijavljeni korisnik"
                                   FontFamily="Tahoma" FontSize="10"
                                   Foreground="#78909C"/>
                        <TextBlock Text="{Binding KorisnikIme}"
                                   FontFamily="Tahoma" FontSize="16" FontWeight="Bold"
                                   Foreground="#1565C0" Margin="0,4,0,0"/>
                        <Separator Margin="0,8,0,8"/>
                        <TextBlock Text="Poslovna godina"
                                   FontFamily="Tahoma" FontSize="10"
                                   Foreground="#78909C"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Godina}"
                                       FontFamily="Tahoma" FontSize="22" FontWeight="Bold"
                                       Foreground="#1565C0"/>
                            <Button Content="Promeni"
                                    FontFamily="Tahoma" FontSize="10"
                                    Foreground="#1565C0" Background="Transparent"
                                    BorderBrush="#90CAF9" BorderThickness="1"
                                    Padding="6,2" Cursor="Hand"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding PromenaGodineCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- ═══ STATUS BAR ═══ -->
        <Border Grid.Row="3" Background="#1565C0">
            <TextBlock Text="F1 — Pomoć    |    ESC / Ctrl+W — Zatvori prozor    |    Enter — Potvrdi"
                       FontFamily="Tahoma" FontSize="10"
                       Foreground="#BBDEFB"
                       VerticalAlignment="Center"
                       Margin="16,0"/>
        </Border>
    </Grid>
</Window>
