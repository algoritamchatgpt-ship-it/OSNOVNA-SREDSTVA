<Window x:Class="OsnovnaSredstva.Views.FirmaIzborWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IZBOR FIRME — OSNOVNA SREDSTVA"
        Width="680" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="580" MinHeight="420"
        Background="#EEF2FF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="#1565C0">
            <Grid Margin="16,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="IZBOR FIRME"
                               FontFamily="Tahoma" FontSize="20" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="{Binding KorisnikInfo}"
                               FontFamily="Tahoma" FontSize="10"
                               Foreground="#BBDEFB"/>
                </StackPanel>

                <!-- Loader desno -->
                <ProgressBar HorizontalAlignment="Right" Width="200" Height="4"
                             IsIndeterminate="True"
                             Foreground="#90CAF9" Background="#0D47A1"
                             BorderThickness="0"
                             VerticalAlignment="Center"
                             Visibility="{Binding Ucitava, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- ═══ LISTA FIRMI ═══ -->
        <Grid Grid.Row="1" Margin="16,12,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Izaberite firmu:"
                       FontFamily="Tahoma" FontSize="12" FontWeight="SemiBold"
                       Foreground="#0D47A1" Margin="0,0,0,6"/>

            <ListBox Grid.Row="1"
                     x:Name="LstFirme"
                     ItemsSource="{Binding Firme}"
                     SelectedItem="{Binding SelektovanaFirma}"
                     FontFamily="Tahoma" FontSize="13"
                     BorderBrush="#90CAF9" BorderThickness="1"
                     Background="White"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding FolderIme}"
                                       FontWeight="Bold" Foreground="#1565C0"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Naziv}"
                                           FontWeight="SemiBold"/>
                                <TextBlock FontSize="10" Foreground="#78909C">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}MB: {0}   PIB: {1}">
                                            <Binding Path="MatBr"/>
                                            <Binding Path="Pib"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="6,2"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#BBDEFB"/>
                                <Setter Property="Foreground" Value="#0D47A1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>

        <!-- ═══ STATUS BAR ═══ -->
        <Border Grid.Row="2" Background="#E8EAF6" Padding="16,6"
                Visibility="{Binding StatusPoruka, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusPoruka}"
                       FontFamily="Tahoma" FontSize="11"
                       Foreground="#37474F"/>
        </Border>

        <!-- ═══ DUGMAD ═══ -->
        <Grid Grid.Row="3" Margin="16,0,16,16" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Akcije nad firmama -->
            <Button Grid.Column="0"
                    Content="+ Nova firma"
                    Style="{StaticResource OsDugmeStyle}"
                    Background="#388E3C" Foreground="White" BorderBrush="#2E7D32"
                    Width="110"
                    Command="{Binding DodajFirmuCommand}"
                    Margin="0,0,6,0"/>

            <Button Grid.Column="1"
                    Content="Arhiviraj"
                    Style="{StaticResource OsDugmeStyle}"
                    Background="#0288D1" Foreground="White" BorderBrush="#01579B"
                    Width="90"
                    Command="{Binding ArhivirajFirmuCommand}"
                    Margin="0,0,6,0"/>

            <Button Grid.Column="2"
                    Content="Obriši firmu"
                    Style="{StaticResource OsDugmeStyle}"
                    Background="#D32F2F" Foreground="White" BorderBrush="#B71C1C"
                    Width="100"
                    Command="{Binding ObrisiFirmuCommand}"/>

            <!-- Desna strana -->
            <Button Grid.Column="4"
                    Content="ODABERI"
                    Style="{StaticResource OsDugmeStyle}"
                    Background="#1565C0" Foreground="White" BorderBrush="#0D47A1"
                    Width="100"
                    IsDefault="True"
                    Command="{Binding PotvrdiCommand}"/>

            <Button Grid.Column="6"
                    Content="Otkaci"
                    Style="{StaticResource OsDugmeStyle}"
                    Background="#546E7A" Foreground="White" BorderBrush="#37474F"
                    Width="80"
                    Command="{Binding OtkaciCommand}"/>
        </Grid>
    </Grid>
</Window>
